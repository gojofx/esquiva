# Copia este archivo como .env y ajusta los valores. .env no se sube al repositorio.
PORT=3000
PROFESOR_PIN=

# PostgreSQL (si no se define DB_USERNAME ni DATABASE_URL, la partida se guarda en data/partida.json)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=esquiva
DB_USERNAME=
DB_PASSWORD=
